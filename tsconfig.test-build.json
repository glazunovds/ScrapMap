{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "node_modules/.cache/scrapmap-test-build",
    "rootDir": "src",
    "sourceMap": false
  },
  "include": [
    "src/domain/**/*.ts",
    "src/data-sources/**/*.ts",
    "src/fixtures/**/*.ts",
    "src/sync/**/*.ts"
  ]
}

